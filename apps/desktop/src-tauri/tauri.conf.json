{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dashboard for Coding Agents",
  "mainBinaryName": "agent-dashboard-desktop",
  "identifier": "io.github.philll11.agent-dashboard",
  "build": {
    "frontendDist": "../../../web/app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @agent-dashboard/app dev",
    "beforeBuildCommand": "pnpm --filter @agent-dashboard/app build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Dashboard for Coding Agents",
        "width": 1296,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false,
        "zoomHotkeysEnabled": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self' data:"
      },
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Leonard Phillips",
    "copyright": "Copyright (c) 2026 Leonard Phillips",
    "license": "MIT",
    "homepage": "https://github.com/philll11/agent-dashboard",
    "category": "DeveloperTool",
    "shortDescription": "See how you use your coding agents: plan limits, usage and cost.",
    "longDescription": "See how you use Claude Code, GitHub Copilot CLI and GitHub Copilot in VS Code: how close you are to your plan limits, what your usage costs, and where it goes.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1 | libappindicator3-1"]
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBNzQyMUY5RDVGOTkwMzUKUldRMWtQblYrU0YwNnVycmxQcjZFbE13TVhEVmJnN0Nub3Frc3JOOXZsQ0ZQckgvZW1adlNGTEMK",
      "endpoints": [
        "https://github.com/philll11/agent-dashboard/releases/latest/download/desktop-update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
